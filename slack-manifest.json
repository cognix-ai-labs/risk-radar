{
  "display_information": {
    "name": "Risk Radar",
    "description": "Turns Slack conversations into early warnings, actionable insights, and project intelligence.",
    "background_color": "#4338ca"
  },
  "features": {
    "bot_user": {
      "display_name": "RiskRadar",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/risk",
        "description": "Get today's risk report",
        "usage_hint": "",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": ["https://REPLACE_WITH_YOUR_DOMAIN/api/slack/oauth/callback"],
    "scopes": {
      "bot": [
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "chat:write",
        "commands",
        "app_mentions:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://REPLACE_WITH_YOUR_DOMAIN/api/slack/events",
      "bot_events": ["app_mention", "message.channels"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://REPLACE_WITH_YOUR_DOMAIN/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
