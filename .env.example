# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Random 32+ char secret used to sign NextAuth session cookies.
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# 32-byte (64 hex char) key used to encrypt Slack/GitHub tokens at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# ── Database ─────────────────────────────────────────────────────────────
# Local dev: run `docker compose up -d` then use this default.
DATABASE_URL=postgresql://riskradar:riskradar@localhost:5432/riskradar

# ── Demo / mock mode ─────────────────────────────────────────────────────
# When true, the dashboard runs entirely on generated demo data — no Slack
# workspace, LLM key, or Stripe account required. Recommended for first run.
DEMO_MODE=true

# ── Slack app (developer.slack.com) ─────────────────────────────────────
# Create an app at https://api.slack.com/apps, then:
#   OAuth & Permissions -> Redirect URL: {APP_URL}/api/slack/oauth/callback
#   Bot Token Scopes: channels:history, channels:read, groups:history,
#     groups:read, chat:write, commands, app_mentions:read, users:read
#   Slash Commands: /risk -> {APP_URL}/api/slack/commands
#   Event Subscriptions -> Request URL: {APP_URL}/api/slack/events
#     Subscribe to: app_mention, message.channels
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── LLM provider ─────────────────────────────────────────────────────────
# provider = mock | openai | anthropic. "mock" needs no key and is used
# automatically when DEMO_MODE=true.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Stripe (dashboard.stripe.com/test/apikeys) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# ── GitHub OAuth App (github.com/settings/developers) ───────────────────
# Callback URL: {APP_URL}/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
